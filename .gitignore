.venv/
__pycache__/
*.pyc

# Training corpora: 6 GB, and fully reproducible via scripts/fetch_data.py +
# scripts/make_procedural.py.
data/

# Training checkpoints are 400-650 MB each (optimizer + EMA state). Only the slimmed
# inference weights are committed, at checkpoints/model.pt.
checkpoints/*
!checkpoints/model.pt

# Regenerated by scripts/package_submission.py; would duplicate the 66 MB weights.
submission/
# Regenerated by scripts/dress_rehearsal.py --keep.
rehearsal/
# The Space carries its own copy of the weights for deployment; not needed in the repo.
space/model.pt

outputs/
runs/
*.part

# Local editor/tooling config, not part of the project.
.claude/

# Scratch inspection output from tuning the corpus filter; the finding it produced is
# written up in NOTES.md §3.58 and does not need the debug images.
mat_accepted.png
mat_rejected.png

# Per-member handover copies of each part; the repo keeps its normal layout because
# src/train.py imports src/dataset.py and moving files would break every import.
Part1_Shubhanker_Ohri/
Part2_Ujjawal_Chaudhary/
Part3_Rashiv_Saran/
